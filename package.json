{
  "name": "@aliakakis/react-templates-components",
  "version": "1.0.0",
  "description": "Simple template based React Components",
  "type": "module",
  "scripts": {
    "build": "npm run preBuildChecks && vp pack",
    "dev": "vp pack",
    "play": "vp dev",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint ./src",
    "lint:fix": "npm run lint -- --fix",
    "format": "vp fmt .",
    "preBuildChecks": "npm run typecheck && npm run lint && npm run format && npm run test",
    "postinstall": "npx playwright install --with-deps chromium",
    "prepare": "vp config"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "stylelint": "^17.16.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0",
    "vite-plus": "1.2.0"
  },
  "keywords": [
    "react",
    "templates"
  ],
  "author": "Antonios Liakakis",
  "license": "ISC",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vitest": "5.0.4"
  }
}
