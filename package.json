{
  "name": "@aliakakis/react-templates-components",
  "version": "1.0.0",
  "description": "Simple template based React Components",
  "type": "module",
  "scripts": {
    "build": "npm run preBuildChecks && cross-env NODE_ENV=production tsdown",
    "build:react-compiler": "npm run preBuildChecks && cross-env NODE_ENV=production USE_REACT_COMPILER=true tsdown",
    "dev": "tsdown",
    "dev:react-compiler": "cross-env USE_REACT_COMPILER=true tsdown",
    "play": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src --ext .ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "preBuildChecks": "npm run typecheck && npm run lint && npm run format && npm run test",
    "prepare": "husky",
    "postinstall": "npx playwright install --with-deps chromium"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@rollup/plugin-babel": "7.1.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "stylelint": "^17.16.0",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0"
  },
  "keywords": [
    "react",
    "templates"
  ],
  "author": "Antonios Liakakis",
  "license": "ISC",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  }
}
